{
  "name": "reblock",
  "version": "1.1.7",
  "description": "A WordPress plugin that manages reusable content blocks.",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build && grunt",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip && node post-process-zip.js",
    "start": "wp-scripts start",
    "ship": "npm run build && npm run plugin-zip",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js"
  },
  "files": [
    "vendor/**",
    "includes/**",
    "build/**",
    "reblock.php",
    "uninstall.php"
  ],
  "keywords": [],
  "author": "",
  "license": "GPLv3",
  "devDependencies": {
    "@wordpress/scripts": "^37.0.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "fs-extra": "^11.4.1",
    "grunt": "^1.6.3",
    "grunt-sass": "^4.1.0",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "sass": "^1.107.1"
  },
  "dependencies": {
    "@wordpress/icons": "^19.0.0"
  }
}
